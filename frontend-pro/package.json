{
  "name": "promo-data-analyzer-frontend-pro",
  "version": "1.0.0",
  "private": true,
  "description": "推广数据分析系统 - Ant Design Pro v6",
  "scripts": {
    "build": "max build",
    "dev": "cross-env UMI_ENV=dev MOCK=none PORT=5175 max dev",
    "start": "cross-env UMI_ENV=dev PORT=5175 max dev",
    "preview": "max preview --port 5175",
    "lint": "npm run biome:lint && npm run tsc",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@ant-design/pro-components": "^3.1.12-0",
    "@tanstack/react-query": "^5.100.6",
    "@uiw/react-md-editor": "^4.0.8",
    "antd": "^6.4.2",
    "antd-style": "^4.1.0",
    "binary-extensions": "^3.1.0",
    "dayjs": "^1.11.20",
    "echarts": "^5.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@umijs/max": "^4.6.51",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
